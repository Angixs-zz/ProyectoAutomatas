# Puerto de la aplicación web / API
APP_PORT=8080

# PostgreSQL
POSTGRES_DB=autotask
POSTGRES_USER=autotask
POSTGRES_PASSWORD=autotask_dev
# Puerto publicado en el host; dentro de la red Docker se usa 5432.
POSTGRES_PORT=5432
# Docker Compose arma DATABASE_URL con POSTGRES_*. Descomenta solo si usas otra base.
# DATABASE_URL=postgresql://autotask:autotask_dev@postgres:5432/autotask

# Correo de pruebas (Mailpit)
SMTP_HOST=mailpit
# Puerto publicado en el host; la app se conecta a Mailpit en el 1025 interno.
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_FROM=autotask@localhost
